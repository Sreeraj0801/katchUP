DATABASE_URL=postgresql://USERNAME@localhost:5432/newsreel
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_DEV=gemini-3.5-flash
GEMINI_MODEL_PROD=gemini-3.5-flash

# Retention policy used by `npm run prune`.
# Full article text is dropped after this many days (summary/TLDR are kept).
RETENTION_STRIP_DAYS=7
# Articles older than this are deleted entirely, unless a user liked them.
RETENTION_DELETE_DAYS=30

# Optional. When set, /api/ingest and /api/cron/prune require
# `Authorization: Bearer <CRON_SECRET>`. Leave unset for local dev.
# CRON_SECRET=change-me
