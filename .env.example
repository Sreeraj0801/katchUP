# MongoDB Atlas connection string. The database name goes in the path, before
# the query string: .../<dbname>?retryWrites=true&w=majority
# NEVER put real credentials in this file - it is committed to git.
# The real values live in .env.local (gitignored) and in Vercel's env settings.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/katchup?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=katchup

# Only needed to run scripts/migrate-to-mongo.mjs against the old Postgres DB.
# The app itself no longer uses Postgres.
DATABASE_URL=postgresql://USERNAME@localhost:5432/newsreel

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_DEV=gemini-3.5-flash
GEMINI_MODEL_PROD=gemini-3.5-flash

# Retention policy used by `npm run prune`.
# Full article text is dropped after this many days (summary/TLDR are kept).
RETENTION_STRIP_DAYS=7
# Articles older than this are deleted entirely, unless a user liked them.
RETENTION_DELETE_DAYS=30

# Optional. When set, /api/ingest and /api/cron/prune require
# `Authorization: Bearer <CRON_SECRET>`. Leave unset for local dev.
# CRON_SECRET=change-me
